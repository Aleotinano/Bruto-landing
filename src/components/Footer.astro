---
import Logo from "./Logo.astro";
import { nav, site } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface-800">
  <div class="container-page flex flex-col gap-8 py-10 md:flex-row md:items-start md:justify-between">
    <div class="max-w-xs">
      <Logo />
      <p class="mt-3 text-sm text-ink-500">Agencia de edición de video corto, desde Argentina.</p>
    </div>
    <nav aria-label="Pie de página" class="grid grid-cols-2 gap-x-12 gap-y-2 text-sm text-ink-700">
      {nav.map((item) => <a href={item.href} class="hover:text-ink-950">{item.label}</a>)}
      {site.instagram && <a href={site.instagram} target="_blank" rel="noopener" class="hover:text-ink-950">Instagram</a>}
      {site.tiktok && <a href={site.tiktok} target="_blank" rel="noopener" class="hover:text-ink-950">TikTok</a>}
      {site.email && <a href={`mailto:${site.email}`} class="hover:text-ink-950">{site.email}</a>}
    </nav>
  </div>
  <div class="container-page border-t border-line py-5 text-xs text-ink-500">© {year} {site.name}</div>
</footer>
