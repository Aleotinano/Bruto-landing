---
import { results } from "../content/site";

// Solo los números reales: los que todavía están vacíos no se muestran, y sin ninguno la sección
// no aparece.
const metrics = results.metrics.filter((m) => m.value);

// El gráfico del caso: visitas por día, como área. Se dibuja en el build (SVG estático, sin JS).
const { views, start, note } = results.chart;
const W = 1000;
const H = 320;
const PAD = { top: 24, right: 8, bottom: 32, left: 8 };
const max = Math.max(...views);
const top = Math.ceil(max / 10000) * 10000;
const x = (i: number) => PAD.left + (i / (views.length - 1)) * (W - PAD.left - PAD.right);
const y = (v: number) => PAD.top + (1 - v / top) * (H - PAD.top - PAD.bottom);
const line = views.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join("");
const area = `${line}L${x(views.length - 1).toFixed(1)} ${y(0)}L${x(0).toFixed(1)} ${y(0)}Z`;
const peak = views.indexOf(max);

const day = (i: number) => {
  const d = new Date(`${start}T12:00:00`);
  d.setDate(d.getDate() + i);
  return d.toLocaleDateString("es-AR", { day: "numeric", month: "short" }).replace(".", "");
};
// Una marca por semana en el eje.
const ticks = views.map((_, i) => i).filter((i) => i % 7 === 0);
const grid = [top / 2, top];
const k = (v: number) => `${Math.round(v / 1000)} mil`;
---

{metrics.length > 0 && (
  <section id="resultados" class="scroll-mt-16 border-b border-line py-20">
    <div class="container-page">
      <p class="eyebrow">Caso real · multicuenta</p>
      <h2 class="section-title mt-3">{results.title}</h2>
      <p class="section-lead">{results.lead}</p>

      <figure class="mt-10 rounded-2xl bg-ink-950 p-4 text-surface-900 sm:p-8">
        <figcaption class="flex flex-wrap items-baseline justify-between gap-2 font-mono text-xs font-bold tracking-wide text-ink-300 uppercase">
          <span>{note}</span>
          <span>{day(0)} – {day(views.length - 1)}</span>
        </figcaption>
        <div class="mt-4 overflow-x-auto">
          <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full min-w-[520px]" role="img" aria-label={`Visitas por día: casi nada hasta fines de octubre, un pico de ${k(max)} el ${day(peak)} y después varios miles por día.`}>
            {grid.map((g) => (
              <g>
                <line x1={PAD.left} x2={W - PAD.right} y1={y(g)} y2={y(g)} stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="4 6" />
                <text x={W - PAD.right} y={y(g) - 6} text-anchor="end" class="fill-ink-300 font-mono text-[13px]">{k(g)}</text>
              </g>
            ))}
            <path d={area} class="fill-brand-500/25" />
            <path d={line} fill="none" class="stroke-brand-500" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
            <line x1={x(peak)} x2={x(peak)} y1={y(max) - 4} y2={y(0)} stroke="currentColor" stroke-width="2" />
            <path d={`M${x(peak) - 7} ${y(max) - 22}h14v8l-7 6l-7 -6z`} fill="currentColor" />
            <text x={x(peak) + 14} y={y(max) + 6} class="fill-surface-900 font-mono text-[15px] font-bold">{k(max)} el {day(peak)}</text>
            {ticks.map((i) => (
              <text x={x(i)} y={H - 8} text-anchor={i === 0 ? "start" : "middle"} class="fill-ink-300 font-mono text-[13px]">{day(i)}</text>
            ))}
          </svg>
        </div>
      </figure>

      <dl class="mt-6 grid grid-cols-2 border-t border-line lg:grid-cols-4">
        {metrics.map((m, i) => (
          <div class:list={["flex flex-col px-2 py-6 sm:px-6", i % 2 === 1 && "border-l border-line", i >= 2 && "border-t border-line lg:border-t-0", i === 2 && "lg:border-l"]}>
            <dt class="order-2 mt-1 text-sm text-ink-700">{m.label}</dt>
            <dd class="font-mono text-3xl font-bold sm:text-4xl">{m.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
