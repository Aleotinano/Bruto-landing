---
import Icon from "./Icon.astro";
import { services } from "../content/site";
---

<section id="servicios" class="border-b border-line py-20">
  <div class="container-page">
    <p class="eyebrow">Servicios</p>
    <h2 class="section-title mt-2">Dos formas de trabajar con nosotros</h2>
    <p class="section-lead">Volumen todos los días para crecer en TikTok, o un número fijo de videos por mes para tus redes.</p>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      {services.map((s) => (
        <article class="flex flex-col rounded-xl border border-line bg-surface-800 p-6 sm:p-8">
          <h3 class="text-xl font-extrabold tracking-[-0.02em] uppercase">{s.title}</h3>
          <p class="mt-3 text-ink-700">{s.lead}</p>
          <ul class="mt-6 space-y-3 border-t border-line pt-6 text-sm">
            {s.points.map((p) => (
              <li class="flex gap-3"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-500" />{p}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
